# Fastlane: builds Wavo and ships it to TestFlight.

APP_IDENTIFIER = "lol.wavo.app"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    # Write the App Store Connect API key to disk. Accept either raw PEM text
    # or base64, matching the repository setup instructions.
    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text =
      if raw.include?("BEGIN PRIVATE KEY")
        raw
      else
        begin
          require "base64"
          Base64.decode64(raw)
        rescue StandardError
          raw
        end
      end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!(
        "ASC_KEY_CONTENT is neither a PEM .p8 key nor base64 of one. Paste " \
        "either the .p8 file's text or its base64 encoding into the secret."
      )
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # Keep Xcode on automatic signing, but make the Release archive explicitly
    # a distribution archive. The project inherited an old iPhone Developer
    # identity at project level, which made xcodebuild request a development
    # profile even though this lane is shipping to the App Store.
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: true,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      build_configurations: ["Release"],
      targets: ["App"]
    )

    # Give xcodebuild permission to contact Apple's provisioning/signing service
    # using the App Store Connect API key. Explicit Release signing values here
    # also prevent a project-level iPhone Developer setting from winning during
    # the archive command.
    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{key_id}",
      "-authenticationKeyIssuerID #{issuer_id}"
    ].join(" ")

    archive_args = [
      auth_args,
      "CODE_SIGN_STYLE=Automatic",
      "DEVELOPMENT_TEAM=#{team_id}",
      "CODE_SIGN_IDENTITY='Apple Distribution'"
    ].join(" ")

    # Bump to the next unused TestFlight build number.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest + 1
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: archive_args,
      export_xcargs: auth_args,
      export_options: {
        signingStyle: "automatic",
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
