# Fastlane: builds Wavo and ships it to TestFlight.
# Capacitor + Swift Package Manager (no CocoaPods): build the .xcodeproj,
# and write signing settings into the project before archiving.

APP_IDENTIFIER = "lol.wavo.app"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    # 1. Write the raw .p8 key text to a file, then authenticate.
    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, ENV["ASC_KEY_CONTENT"])

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # 2. Fresh temporary keychain for the signing certificate.
    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Distribution certificate — REUSE an existing one instead of
    #    creating a new one each run (avoids hitting Apple's cert limit).
    cert(
      api_key: api_key,
      generate_apple_certs: false,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    )

    # 4. Provisioning profile matching that certificate.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    # 5. Write signing settings straight into the project file.
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    # 6. Build & archive.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    # 7. Upload to TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
