# Fastlane: builds Wavo and ships it to TestFlight.

APP_IDENTIFIER = "lol.wavo.app"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    # 1. Write the .p8 key to a file, then authenticate.
    #
    # PIPELINE-SETUP.md tells you to base64-encode the .p8 before pasting it
    # into the secret, but this wrote whatever it was given straight to disk.
    # Following the instructions therefore produced a file full of base64 text
    # where a PEM key was expected, and the very first App Store Connect call
    # failed. Accept either form: decode when it doesn't already look like PEM.
    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text =
      if raw.include?("BEGIN PRIVATE KEY")
        raw
      else
        begin
          require "base64"
          Base64.decode64(raw)
        rescue StandardError
          raw
        end
      end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!(
        "ASC_KEY_CONTENT is neither a PEM .p8 key nor base64 of one. Paste " \
        "either the .p8 file's text or its base64 encoding into the secret."
      )
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # 2. Fresh temporary keychain for the signing certificate.
    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Distribution certificate.
    cert(
      api_key: api_key,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    )

    # 4. Provisioning profile matching that certificate.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    # 5. Write signing settings straight into the project file.
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    # 5b. Bump the build number to the next unused value on App Store Connect,
    #     so each upload has a unique, higher number than the last.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest + 1
    )

    # 6. Build & archive.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    # 7. Upload to TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
