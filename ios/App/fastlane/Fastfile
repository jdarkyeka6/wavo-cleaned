# Fastlane: builds Wavo and ships it to TestFlight.
# Capacitor + Swift Package Manager (no CocoaPods), so we build the
# .xcodeproj directly and inject the signing team at build time.

APP_IDENTIFIER = "lol.wavo.app"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    # 1. Write the raw .p8 key text to a file, then authenticate with it.
    #    ASC_KEY_CONTENT holds the plain -----BEGIN PRIVATE KEY----- text,
    #    so we write it as-is (no base64 decoding).
    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, ENV["ASC_KEY_CONTENT"])

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path
    )

    # 2. Fresh temporary keychain to hold the signing certificate.
    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Distribution certificate (created fresh on this cloud Mac).
    cert(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    )

    # 4. Provisioning profile matching that certificate.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]

    # 5. Build & archive, injecting the team + profile so Xcode signs manually.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} " \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\"",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    # 6. Upload to TestFlight (don't wait for Apple's processing).
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
