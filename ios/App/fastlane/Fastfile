# Fastlane: builds Wavo and ships it to TestFlight.

APP_IDENTIFIER = "lol.wavo.app"
LIVE_ACTIVITY_IDENTIFIER = "lol.wavo.app.WavoLiveActivity"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text =
      if raw.include?("BEGIN PRIVATE KEY")
        raw
      else
        begin
          require "base64"
          Base64.decode64(raw)
        rescue StandardError
          raw
        end
      end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!("ASC_KEY_CONTENT is neither a PEM .p8 key nor base64 of one.")
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    require "spaceship"

    live_bundle = Spaceship::ConnectAPI::BundleId.find(LIVE_ACTIVITY_IDENTIFIER)
    unless live_bundle
      UI.message("Registering #{LIVE_ACTIVITY_IDENTIFIER} for the Live Activity extension")
      Spaceship::ConnectAPI::BundleId.create(
        name: "Wavo Live Activity",
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        identifier: LIVE_ACTIVITY_IDENTIFIER
      )
    end

    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    cert_args = {
      api_key: api_key,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    }

    # Reuse Wavo's existing CI signing identity when available. The stored
    # PKCS#12 archive is AES-GCM encrypted using a separate derived key.
    # Nothing is restored from an unrelated app or development certificate.
    sh("node #{ENV.fetch('GITHUB_WORKSPACE')}/scripts/wavo-ci-signing.js restore #{cert_args[:keychain_path]} #{keychain_pw}", log: true)

    # TestFlight builds must never revoke an existing Apple distribution
    # certificate automatically: it may sign other apps or releases.
    # If no certificate slot is available, fail safely so the account owner
    # can recover signing without invalidating unrelated builds.
    begin
      cert(**cert_args)
    rescue => e
      UI.user_error!(
        "Apple Distribution signing is unavailable without revoking an existing " \
        "certificate. Existing certificates were not modified. " \
        "Check Apple Developer Certificates and install reusable CI signing credentials. " \
        "Original error: #{e.message}"
      )
    end

    # Preserve a newly generated private key before attempting provisioning,
    # building, or uploading. Without this, ephemeral GitHub runners would
    # consume a new Apple Distribution certificate on every TestFlight build.
    sh("node #{ENV.fetch('GITHUB_WORKSPACE')}/scripts/wavo-ci-signing.js save #{cert_args[:keychain_path]} #{keychain_pw}", log: true)

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    app_profile_name = lane_context[SharedValues::SIGH_NAME]

    sigh(
      api_key: api_key,
      app_identifier: LIVE_ACTIVITY_IDENTIFIER,
      force: true
    )
    live_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile_name,
      targets: ["App"]
    )

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: live_profile_name,
      targets: ["WavoLiveActivity"]
    )

    # Version 1.1 has already been approved, so new TestFlight uploads use the 1.2 train.
    marketing_version = "1.2"
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: marketing_version,
      initial_build_number: 0
    )
    next_build = latest_build.to_i + 1
    UI.message("Using Wavo #{marketing_version} TestFlight build #{next_build} (latest uploaded: #{latest_build}).")

    increment_version_number(
      xcodeproj: "App.xcodeproj",
      version_number: marketing_version
    )
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: next_build
    )

    # Keep the embedded extension on exactly the same version/build as the host app.
    update_info_plist(
      plist_path: "WavoLiveActivity/Info.plist",
      block: proc do |plist|
        plist["CFBundleVersion"] = next_build.to_s
        plist["CFBundleShortVersionString"] = marketing_version
      end
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => app_profile_name,
          LIVE_ACTIVITY_IDENTIFIER => live_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
