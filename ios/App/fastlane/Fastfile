# Fastlane: builds Wavo and ships it to TestFlight.
# Signing uses an App Store Connect API key. The project is a Capacitor
# app using Swift Package Manager (no CocoaPods), so we build the
# .xcodeproj directly and inject the signing team at build time.

APP_IDENTIFIER = "lol.wavo.app"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    # 1. Authenticate with App Store Connect using the API key.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # 2. Fresh temporary keychain to hold the signing certificate.
    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Distribution certificate (created fresh on this cloud Mac).
    cert(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    )

    # 4. Provisioning profile matching that certificate.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]

    # 5. Build & archive. We hand Xcode the team + profile explicitly via
    #    xcargs, because the .xcodeproj has no team set — that was the
    #    "requires a development team" error.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} " \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=\"Apple Distribution\" " \
              "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\"",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    # 6. Upload to TestFlight. We don't wait for Apple's processing —
    #    the build just appears in TestFlight a few minutes later.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
