# Fastlane: builds Wavo and ships it to TestFlight.

APP_IDENTIFIER = "lol.wavo.app"
LIVE_ACTIVITY_IDENTIFIER = "lol.wavo.app.WavoLiveActivity"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text =
      if raw.include?("BEGIN PRIVATE KEY")
        raw
      else
        begin
          require "base64"
          Base64.decode64(raw)
        rescue StandardError
          raw
        end
      end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!("ASC_KEY_CONTENT is neither a PEM .p8 key nor base64 of one.")
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    require "spaceship"

    live_bundle = Spaceship::ConnectAPI::BundleId.find(LIVE_ACTIVITY_IDENTIFIER)
    unless live_bundle
      UI.message("Registering #{LIVE_ACTIVITY_IDENTIFIER} for the Live Activity extension")
      Spaceship::ConnectAPI::BundleId.create(
        name: "Wavo Live Activity",
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        identifier: LIVE_ACTIVITY_IDENTIFIER
      )
    end

    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Reuse the existing Apple Distribution identity, including its private key.
    # An API key alone cannot retrieve the private key from Apple.
    # Fail safely instead of creating or revoking certificates.
    require "base64"
    require "tempfile"
    p12_b64 = ENV["APPLE_DISTRIBUTION_P12_BASE64"].to_s.strip
    p12_password = ENV["APPLE_DISTRIBUTION_P12_PASSWORD"].to_s
    if p12_b64.empty? || p12_password.empty?
      UI.user_error!("Reusable signing identity not configured. Add APPLE_DISTRIBUTION_P12_BASE64 and APPLE_DISTRIBUTION_P12_PASSWORD secrets. No certificates will be created or revoked.")
    end

    p12_file = Tempfile.new(["wavo-distribution", ".p12"])
    begin
      p12_file.binmode
      p12_file.write(Base64.strict_decode64(p12_b64))
      p12_file.flush
      import_certificate(
        certificate_path: p12_file.path,
        certificate_password: p12_password,
        keychain_name: keychain_name,
        keychain_password: keychain_pw
      )
    ensure
      p12_file.close!
    end
    # Verify the imported identity contains a usable signing private key.
    identities = sh("security find-identity -v -p codesigning #{File.expand_path("~/Library/Keychains/#{keychain_name}-db")}", log: false)
    unless identities.include?("Apple Distribution") || identities.include?("iPhone Distribution")
      UI.user_error!("No valid Apple Distribution signing identity with private key was imported.")
    end

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    app_profile_name = lane_context[SharedValues::SIGH_NAME]

    sigh(
      api_key: api_key,
      app_identifier: LIVE_ACTIVITY_IDENTIFIER,
      force: true
    )
    live_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile_name,
      targets: ["App"]
    )

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: live_profile_name,
      targets: ["WavoLiveActivity"]
    )

    # Version 1.1 has already been approved, so new TestFlight uploads use the 1.2 train.
    marketing_version = "1.2"
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: marketing_version,
      initial_build_number: 0
    )
    next_build = latest_build.to_i + 1
    UI.message("Using Wavo #{marketing_version} TestFlight build #{next_build} (latest uploaded: #{latest_build}).")

    increment_version_number(
      xcodeproj: "App.xcodeproj",
      version_number: marketing_version
    )
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: next_build
    )

    # Keep the embedded extension on exactly the same version/build as the host app.
    update_info_plist(
      plist_path: "WavoLiveActivity/Info.plist",
      block: proc do |plist|
        plist["CFBundleVersion"] = next_build.to_s
        plist["CFBundleShortVersionString"] = marketing_version
      end
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => app_profile_name,
          LIVE_ACTIVITY_IDENTIFIER => live_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
