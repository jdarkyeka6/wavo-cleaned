# Fastlane: builds Wavo and ships it to TestFlight.

APP_IDENTIFIER = "lol.wavo.app"

default_platform(:ios)

platform :ios do
  desc "Build Wavo and upload to TestFlight"
  lane :beta do
    key_id    = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    team_id   = ENV["APPLE_TEAM_ID"].to_s.strip

    raw = ENV["ASC_KEY_CONTENT"].to_s.strip
    key_text =
      if raw.include?("BEGIN PRIVATE KEY")
        raw
      else
        begin
          require "base64"
          Base64.decode64(raw)
        rescue StandardError
          raw
        end
      end

    unless key_text.include?("BEGIN PRIVATE KEY")
      UI.user_error!("ASC_KEY_CONTENT is neither a PEM .p8 key nor base64 of one.")
    end

    key_path = File.expand_path("~/asc_api_key.p8")
    File.write(key_path, key_text)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    keychain_name = "wavo-ci.keychain"
    keychain_pw = "ci-temp-pw"
    create_keychain(
      name: keychain_name,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    cert_args = {
      api_key: api_key,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_pw
    }

    begin
      cert(**cert_args)
    rescue => e
      msg = e.message.to_s
      unless msg.downcase.include?("maximum number") && msg.downcase.include?("distribution certificate")
        raise
      end

      require "spaceship"
      require "time"

      allowed_types = [
        Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
        Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
      ]

      distribution_certs = Spaceship::ConnectAPI::Certificate.all.select do |candidate|
        allowed_types.include?(candidate.certificate_type)
      end

      if distribution_certs.empty?
        UI.user_error!("Apple reported the Distribution certificate limit, but no distribution certificates were returned for revocation.")
      end

      oldest = distribution_certs.min_by do |candidate|
        begin
          Time.parse(candidate.expiration_date.to_s)
        rescue StandardError
          Time.at(0)
        end
      end

      UI.important(
        "Distribution certificate limit reached. Revoking oldest distribution certificate " \
        "#{oldest.display_name || oldest.name || oldest.id} (#{oldest.certificate_type}, expires #{oldest.expiration_date || 'unknown'}), then retrying."
      )
      oldest.delete!
      sleep 3
      cert(**cert_args)
    end

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest + 1
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
